---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Article from '../../layouts/Article.astro';
import { formatDate, readingTime } from '../../lib/site';

export async function getStaticPaths() {
    const posts = (await getCollection('journal')).sort((a, b) => a.data.date.getTime() - b.data.date.getTime() || a.id.localeCompare(b.id));
    return posts.map((p, i) => ({ params: { slug: p.id }, props: { p, prev: posts[i - 1], next: posts[i + 1] } }));
}

interface Props {
    p: CollectionEntry<'journal'>;
    prev?: CollectionEntry<'journal'>;
    next?: CollectionEntry<'journal'>;
}

const { p, prev, next } = Astro.props;
const { Content, headings } = await render(p);
const link = (x?: CollectionEntry<'journal'>) => x && { href: `/journal/${x.id}/`, title: x.data.title };
---

<Article
    title={p.data.title}
    excerpt={p.data.excerpt}
    eyebrow={`Journal · ${p.data.eventType ?? 'Blog'}`}
    back={{ href: '/journal/', label: 'Journal' }}
    meta={[['Published', formatDate(p.data.date)], ['Reading time', readingTime(p.body)]]}
    headings={headings}
    filePath={p.filePath}
    cover={p.data.cover}
    pager={{ prev: link(prev), next: link(next), label: 'More from the journal' }}
>
    <Content />
</Article>
