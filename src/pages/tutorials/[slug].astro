---
import { getCollection, render } from 'astro:content';
import Article from '../../layouts/Article.astro';
import TutorialFacts from '../../components/TutorialFacts.astro';
import { projects, formatDate, coverOf, entryMedia, seriesOf, needsList, type Tutorial } from '../../lib/site';

export async function getStaticPaths() {
    return (await getCollection('tutorials')).map(t => ({ params: { slug: t.id }, props: { t } }));
}

const { t } = Astro.props as { t: Tutorial };
const { Content, headings } = await render(t);
const linked = (await projects()).filter(p => t.data.projects.includes(p.id.toLowerCase()));
const needs = needsList(t.data.needs);
const cover = coverOf(t);

// A part of a series names the series in its eyebrow and links to the parts before and after it
const series = await seriesOf(t);
const at = series.findIndex(x => x.id === t.id);
const link = (x?: Tutorial) => x && { href: `/tutorials/${x.id}/`, title: x.data.title };
const pager = series.length > 1 ? { prev: link(series[at - 1]), next: link(series[at + 1]), label: t.data.series! } : undefined;
const eyebrow = ['Tutorial', t.data.session && `${t.data.session} session`, series.length > 1 && `${t.data.series} · part ${at + 1} of ${series.length}`].filter(Boolean).join(' · ');
---

<Article
    title={t.data.title}
    excerpt={t.data.excerpt}
    eyebrow={eyebrow}
    back={{ href: '/tutorials/', label: 'All tutorials' }}
    headings={headings}
    filePath={t.filePath}
    aiAssisted={t.data.aiAssisted}
    media={entryMedia(t, t.data.title, [cover])}
    cover={cover}
    pager={pager}
>
    <Fragment slot="head">
        <div class="t-facts" data-pagefind-ignore>
            <TutorialFacts level={t.data.level} duration={t.data.duration} />
        </div>
        <p class="t-byline" data-pagefind-ignore>
            {t.data.author ? `${t.data.author} · updated` : 'Updated'} {formatDate(t.data.date)}
            {linked.length > 0 && <> · part of {linked.map((p, i) => <>{i > 0 && ', '}<a href={`/projects/${p.id}/`}>{p.data.title}</a></>)}</>}
        </p>
        {needs.length > 0 && (
            <div class="t-needs">
                <p class="eyebrow">Before you start</p>
                <ul>{needs.map(n => <li>{n}</li>)}</ul>
            </div>
        )}
    </Fragment>
    <Content />
</Article>
