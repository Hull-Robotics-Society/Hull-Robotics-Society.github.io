---
import Base from '../../layouts/Base.astro';
import ProjectTabs from '../../components/ProjectTabs.astro';
import ProjectGrid from '../../components/ProjectGrid.astro';
import { projects } from '../../lib/site';

const items = (await projects()).filter(p => p.data.kind === 'robot');
---

<Base title="Robots" description="The robots of the Hull University Robotics Society, each with its own page.">
    <ProjectTabs active="robots" />
    <ProjectGrid items={items} sort="title" />
</Base>
