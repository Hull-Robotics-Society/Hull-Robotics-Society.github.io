---
import Base from '../../layouts/Base.astro';
import ProjectTabs from '../../components/ProjectTabs.astro';
import ProjectGrid from '../../components/ProjectGrid.astro';
import { projects } from '../../lib/site';

const items = (await projects()).filter(p => p.data.kind === 'project');
---

<Base title="Projects" description="Projects from the Hull University Robotics Society, including the ones we build with our robots.">
    <ProjectTabs active="projects" />
    <ProjectGrid items={items} />
</Base>
