---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found">
    <div class="wrap page-head" style="padding-bottom:120px">
        <p class="eyebrow">Error 404</p>
        <h1>This page has wandered off</h1>
        <p>It may have moved when we rebuilt the website. Try one of these instead.</p>
        <div class="hero-cta">
            <a class="btn" href="/">Home</a>
            <a class="btn ghost" href="/projects/">Projects</a>
            <a class="btn ghost" href="/events/">Events</a>
            <a class="btn ghost" href="/tutorials/">Tutorials</a>
        </div>
    </div>
</Base>
