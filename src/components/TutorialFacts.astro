---
import { levelSteps, type Tutorial } from '../lib/site';

interface Props {
    level: Tutorial['data']['level'];
    duration: string;
}

// A tutorial's level (three dots, filled up to its level) and how long it takes.
// Used on the tutorial's own page and on its card.
const { level, duration } = Astro.props;
---

<span class="t-fact level" data-n={levelSteps[level]}><i></i><i></i><i></i>{level}</span>
<span class="t-fact time">
    <svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="6.25" /><path d="M8 4.5V8l2.5 1.5" /></svg>
    {duration}
</span>
