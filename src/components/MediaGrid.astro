---
import type { MediaItem } from '../lib/site';
import Credit from './Credit.astro';

interface Props {
    items: MediaItem[];
}

// Masonry of photos and videos. Photos open full size in a lightbox.
const { items } = Astro.props;
---

<div class="masonry" data-lightbox>
    {items.map(m => (
        <figure>
            {m.kind === 'video'
                ? <video src={m.src} poster={m.poster} controls playsinline preload="none" aria-label={m.alt}></video>
                : <img src={m.src} alt={m.alt} loading="lazy" decoding="async" />}
            <Credit src={m.src} />
        </figure>
    ))}
</div>

<script>
    for (const grid of document.querySelectorAll<HTMLElement>('[data-lightbox]')) {
        grid.addEventListener('click', e => {
            const img = (e.target as HTMLElement).closest('img');
            if (!img) return;

            const box = document.createElement('div');
            box.className = 'lightbox';
            box.setAttribute('role', 'dialog');
            box.setAttribute('aria-modal', 'true');
            box.setAttribute('aria-label', img.alt);
            const big = img.cloneNode() as HTMLImageElement;
            big.removeAttribute('loading');
            const close = document.createElement('button');
            close.className = 'icon-btn';
            close.type = 'button';
            close.setAttribute('aria-label', 'Close');
            close.style.background = 'var(--surface)';
            close.textContent = '✕';
            const credit = img.parentElement?.querySelector('.credit');
            box.append(big, close);
            if (credit) box.append(Object.assign(credit.cloneNode(true) as HTMLElement, { className: 'credit credit-overlay lightbox-credit' }));

            const done = () => { box.remove(); removeEventListener('keydown', esc); img.focus(); };
            const esc = (ev: KeyboardEvent) => { if (ev.key === 'Escape') done(); };
            box.addEventListener('click', ev => { if (ev.target === box || ev.target === close) done(); });
            addEventListener('keydown', esc);
            document.body.appendChild(box);
            close.focus();
        });
    }
</script>
