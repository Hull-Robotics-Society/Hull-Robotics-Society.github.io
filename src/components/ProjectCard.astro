---
import Credit from './Credit.astro';
import DrawnCover from './DrawnCover.astro';
import { projects, timelineOf, formatMonth, statusLabel, statusChip, coverOf, type Project } from '../lib/site';

interface Props {
    p: Project;
}

// A project's card on the Projects page and on the pages of the robots it uses.
const { p } = Astro.props;
const logs = await timelineOf(p);
const robots = (await projects()).filter(r => p.data.robots.includes(r.id.toLowerCase()));
// Without a picture the card draws a cover with the project's initials: "Baxter ROS 2 bridge" → "BR"
const updated = logs[0]?.data.date ?? p.data.started;
const initials = p.data.title.split(/\s+/).filter(w => /^[A-Za-z]/.test(w)).slice(0, 2).map(w => w[0].toUpperCase()).join('');
---

<a class="card" href={`/projects/${p.id}/`} data-tags={p.data.filters.join(' ')} data-title={p.data.title} data-updated={updated?.getTime() ?? 0} data-started={p.data.started?.getTime() ?? 0}>
    <div class="media">
        {coverOf(p)
            ? <img src={coverOf(p)} alt={p.data.title} loading="lazy" decoding="async" style={p.data.coverFit === 'contain' ? 'object-fit:contain;background:#fff' : undefined} />
            : <DrawnCover seed={p.id} mark={initials} />}
        <Credit src={coverOf(p)} linked={false} length="short" />
    </div>
    <div class="body spread">
        <span class={`${statusChip[p.data.status]} bare`}>{statusLabel[p.data.status]}</span>
        <h3>{p.data.title}</h3>
        {robots.length > 0 && <div class="meta robots">{robots.map(r => <span class="chip robot">{r.data.title}</span>)}</div>}
        <p class="muted">{p.data.summary}</p>
        <div class="foot">
            {p.data.tags.length > 0 && <div class="meta">{p.data.tags.map(t => <span class="chip">{t}</span>)}</div>}
            <div class="stats">
                <span>{logs.length} {logs.length === 1 ? 'log entry' : 'log entries'}</span>
                {(logs.length > 0 || p.data.started) && <span>{logs.length ? `Last update ${formatMonth(logs[0].data.date)}` : `Started ${formatMonth(p.data.started)}`}</span>}
            </div>
        </div>
    </div>
</a>
