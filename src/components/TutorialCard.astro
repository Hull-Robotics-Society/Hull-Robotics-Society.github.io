---
import TutorialFacts from './TutorialFacts.astro';
import DrawnCover from './DrawnCover.astro';
import { coverOf, type Tutorial } from '../lib/site';

interface Props {
    t: Tutorial;
    // The project or topic the tutorial is filed under on the Tutorials page ('workshops' for neither)
    group: { id: string; label: string };
}

// A tutorial's card on the Tutorials page. Parts of a series say which part they are.
const { t, group } = Astro.props;
const cover = coverOf(t);
const kicker = t.data.part ? `Part ${t.data.part}` : group.id === 'workshops' ? (t.data.tags[0] ?? 'Tutorial') : group.label;
---

<a class="card t-card" href={`/tutorials/${t.id}/`} data-group={group.id} data-level={t.data.level}>
    <div class="media">
        {cover
            ? <img src={cover} alt="" loading="lazy" decoding="async" />
            : <DrawnCover seed={t.id} mark={t.data.part ? String(t.data.part).padStart(2, '0') : undefined} level={t.data.level} />}
    </div>
    <div class="body spread">
        <p class="eyebrow">{kicker}</p>
        <h3>{t.data.title}</h3>
        <p class="muted">{t.data.excerpt}</p>
        <div class="foot">
            {t.data.tags.length > 0 && <div class="meta">{t.data.tags.slice(0, 3).map(x => <span class="chip">{x}</span>)}</div>}
            <div class="stats"><TutorialFacts level={t.data.level} duration={t.data.duration} /></div>
        </div>
    </div>
</a>
