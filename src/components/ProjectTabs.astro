---
import { getCollection } from 'astro:content';

interface Props {
    active: 'robots' | 'projects' | 'research';
}

// Page head and the Robots / Projects / Research tab bar shared by /projects/, /projects/all/ and /research/.
const { active } = Astro.props;
const all = await getCollection('projects');
const counts = {
    robots: all.filter(p => p.data.kind === 'robot').length,
    projects: all.filter(p => p.data.kind === 'project').length,
    research: new Set((await getCollection('research')).map(r => r.data.area)).size
};
const ledes = {
    robots: "The robots we look after and build. Pick one to see how it started, what broke, and where it's going.",
    projects: 'What we build and make with our robots, and the builds that stand on their own.',
    research: 'Research lives in its own tab: the reading, experiments and write-ups that feed into our builds.'
};
const lede = ledes[active];
---

<div class="wrap page-head">
    <p class="eyebrow">Projects</p>
    <h1>Things we're building</h1>
    <p>{lede}</p>
</div>
<div class="wrap">
    <nav class="tabs" aria-label="Robots, projects and research">
        <a href="/projects/" aria-current={active === 'robots' ? 'page' : undefined} aria-selected={active === 'robots' ? 'true' : 'false'}>Robots <span>{counts.robots}</span></a>
        <a href="/projects/all/" aria-current={active === 'projects' ? 'page' : undefined} aria-selected={active === 'projects' ? 'true' : 'false'}>Projects <span>{counts.projects}</span></a>
        <a href="/research/" aria-current={active === 'research' ? 'page' : undefined} aria-selected={active === 'research' ? 'true' : 'false'}>Research <span>{counts.research}</span></a>
    </nav>
</div>
