---
// Circuit traces that draw into the society emblem, with signal pulses running along them.
const traces = [
    'M10 260 H178', 'M24 140 H112 L152 180 H192', 'M40 420 H120 L160 380 H202', 'M70 330 H140 L160 310 H180',
    'M630 260 H462', 'M616 140 H528 L488 180 H448', 'M600 420 H520 L480 380 H438', 'M570 330 H500 L480 310 H460',
    'M300 8 V64 L320 84 V112', 'M372 20 V70 L352 90 V116', 'M268 20 V78 L288 98 V118',
    'M320 512 V408', 'M262 500 V456 L284 434 V402', 'M378 500 V456 L356 434 V402'
];
const pads = traces.map(d => d.match(/^M(\d+) (\d+)/)!.slice(1).map(Number));
---

<div class="board" aria-hidden="true">
    <svg viewBox="0 0 640 520">
        <g class="traces">
            {traces.map((d, i) => <path pathLength="1" style={`--i:${i}`} d={d}></path>)}
        </g>
        <g class="pads">
            {pads.map(([x, y], i) => <circle style={`--i:${i}`} cx={x} cy={y} r="5"></circle>)}
        </g>
        <g id="pulses"></g>
    </svg>
    <div class="ring"></div>
    <div class="emblem"></div>
</div>

<script>
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const g = document.getElementById('pulses')!;
        const paths = [...document.querySelectorAll<SVGPathElement>('.board .traces path')];
        const pulses = [0, 2, 5, 8, 11, 6].map((pi, k) => {
            const c = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
            c.setAttribute('r', '3.2');
            c.setAttribute('class', 'pulse');
            g.appendChild(c);
            const p = paths[pi];
            return { c, p, len: p.getTotalLength(), t: k * 0.37, speed: 0.22 + (k % 3) * 0.05 };
        });
        let last = performance.now();
        const tick = (now: number) => {
            const dt = Math.min(0.05, (now - last) / 1000);
            last = now;
            for (const s of pulses) {
                s.t = (s.t + dt * s.speed) % 1.6;
                const u = Math.min(1, s.t);
                const pt = s.p.getPointAtLength(u * s.len);
                s.c.setAttribute('cx', String(pt.x));
                s.c.setAttribute('cy', String(pt.y));
                s.c.style.opacity = String(s.t > 1 ? 0 : u < 0.1 ? u * 10 : 1);
            }
            requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
    }
</script>
