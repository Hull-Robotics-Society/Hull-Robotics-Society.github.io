---
import type { MarkdownHeading } from 'astro';
import Base from './Base.astro';
import site from '../data/site.json';
import MediaGrid from '../components/MediaGrid.astro';
import { editUrl, type MediaItem } from '../lib/site';

interface Props {
    title: string;
    excerpt?: string;
    eyebrow: string;
    back: { href: string; label: string };
    meta?: [string, string][];
    headings?: MarkdownHeading[];
    filePath?: string;
    cover?: string;
    aiAssisted?: boolean;
    // Photos and videos shown as a grid under the text
    media?: MediaItem[];
    pager?: { prev?: { href: string; title: string }; next?: { href: string; title: string }; label: string };
}

// Long-form page for build logs, tutorials, journal posts, research and events.
const { title, excerpt, eyebrow, back, meta = [], headings = [], filePath, cover, pager, aiAssisted = false, media = [] } = Astro.props;
const toc = headings.filter(h => h.depth === 2 || h.depth === 3);
const showToc = toc.filter(h => h.depth === 2).length >= 3;
const technical = /Build log|Documentation|Tutorial/.test(eyebrow);
---

<Base title={title} description={excerpt} image={cover} search={eyebrow}>
    <div class="a-head">
        <div class="wrap">
            <a class="crumb" href={back.href} data-pagefind-ignore>← {back.label}</a>
            <p class="eyebrow" style="margin-top:16px" data-pagefind-ignore>{eyebrow}</p>
            <h1>{title}</h1>
            {excerpt && <p class="lede">{excerpt}</p>}
            {meta.length > 0 && (
                <dl class="a-meta" data-pagefind-ignore>
                    {meta.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
                </dl>
            )}
            {aiAssisted && (
                <p class="ai-note" data-pagefind-ignore>
                    <span class="mono">AI-assisted</span>
                    This page was drafted with the help of AI tools and reviewed by its author.{technical && ' Check commands against the linked repository before running them on a robot.'} <a href="/about/#website">How we use AI</a>
                </p>
            )}
        </div>
    </div>
    <div class:list={['wrap', 'a-body', { 'no-toc': !showToc }]}>
        {showToc && (
            <nav class="toc" aria-label="On this page" data-pagefind-ignore>
                <p class="eyebrow">On this page</p>
                {toc.map(h => <a href={`#${h.slug}`} class={`depth-${h.depth}`} data-toc>{h.text}</a>)}
            </nav>
        )}
        <div style="min-width:0">
            <article class="prose-md">
                <slot />
            </article>
            <script is:inline>
                // Pictures side by side (.media-row) share the width by their shape, so they line up at one
                // height and fill the column. Runs before the pictures load, so nothing jumps.
                for (const row of document.querySelectorAll('.prose-md .media-row')) {
                    const items = [...row.children];
                    const ratios = items.map(m => +m.getAttribute('width') / +m.getAttribute('height'));
                    if (!items.length || ratios.some(r => !r)) continue;
                    // ×100 because flex only hands out all the space when the factors add up to at least 1
                    items.forEach((m, i) => { m.style.flex = `${ratios[i] * 100} 1 0`; });
                    row.style.maxWidth = `calc(440px * ${ratios.reduce((a, b) => a + b)} + 12px * ${items.length - 1})`;
                    row.classList.add('fit');
                }
            </script>
            {media.length > 0 && (
                <section class="a-gallery" id="media" aria-labelledby="media-h" data-pagefind-ignore>
                    <h2 id="media-h">Photos and video</h2>
                    <MediaGrid items={media} />
                </section>
            )}
            <p style="margin-top:48px" data-pagefind-ignore><a class="edit-link" href={editUrl(filePath, site.sourceRepo, site.sourceBranch)} target="_blank" rel="noopener">Spotted a mistake? Edit this page on GitHub ↗</a></p>
            {pager && (pager.prev || pager.next) && (
                <nav class="pager" aria-label={pager.label} data-pagefind-ignore>
                    {pager.prev ? <a href={pager.prev.href}><span>← Previous</span><strong>{pager.prev.title}</strong></a> : <span></span>}
                    {pager.next && <a href={pager.next.href}><span>Next →</span><strong>{pager.next.title}</strong></a>}
                </nav>
            )}
        </div>
    </div>
</Base>

<script>
    import { scrollToY } from '../scripts/scroll';

    // Highlight the section being read and scroll smoothly from the contents list.
    const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc]')];
    if (links.length) {
        const target = (a: HTMLAnchorElement) => document.getElementById(decodeURIComponent(a.hash.slice(1)));
        links.forEach(a => a.addEventListener('click', e => {
            const el = target(a);
            if (!el) return;
            e.preventDefault();
            scrollToY(el.getBoundingClientRect().top + scrollY - document.querySelector<HTMLElement>('.site-header')!.offsetHeight - 24);
            history.replaceState(null, '', a.hash);
        }));
        const update = () => {
            let on = links[0];
            for (const a of links) {
                const el = target(a);
                if (el && el.getBoundingClientRect().top < innerHeight * 0.35) on = a;
            }
            links.forEach(a => a.classList.toggle('on', a === on));
        };
        addEventListener('scroll', update, { passive: true });
        update();
    }
</script>
